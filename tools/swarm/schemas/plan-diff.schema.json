{
  "type": "object",
  "properties": {
    "analysis": {"type": "string"},
    "summary": {"type": "string"},
    "ops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {"type": "string", "enum": ["add", "update", "remove"]},
          "id": {"type": "string", "minLength": 1},
          "task": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "title": {"type": "string"},
              "type": {"type": "string", "enum": ["feature", "feature-tests", "test-task", "idea"]},
              "milestone": {"type": "string"},
              "gate": {"type": "string", "enum": ["full", "module"]},
              "paths": {"type": "array", "items": {"type": "string"}},
              "test_module": {"type": "string"},
              "spec": {"type": "string"},
              "acceptance": {"type": "array", "items": {"type": "string"}},
              "deps": {"type": "array", "items": {"type": "string"}},
              "status": {"type": "string", "enum": ["pending", "blocked"]}
            },
            "additionalProperties": false
          },
          "reason": {"type": "string"}
        },
        "required": ["op", "id", "reason"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"op": {"const": "add"}}, "required": ["op"]},
            "then": {
              "required": ["task"],
              "properties": {
                "task": {
                  "required": ["id", "title", "type", "milestone", "gate", "paths",
                               "test_module", "spec", "acceptance", "deps", "status"]
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": ["analysis", "summary", "ops"],
  "additionalProperties": false
}
