#!/bin/sh
# Единая точка входа: swarm <команда>
#
# Путь разрешается через symlink: команда ставится в ~/.local/bin/swarm
# ссылкой сюда, и `dirname "$0"` тогда указывал бы на каталог ссылки,
# а не на код.
self="$0"
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case "$link" in
        /*) self="$link" ;;
        *)  self="$(dirname "$self")/$link" ;;
    esac
done
here="$(cd "$(dirname "$self")" && pwd)"
# Tab оболочки — мимо cli.py: его импорт стоит ~0.3 с, а подсказка
# обязана успевать за пальцами (см. swarm/clitab.py).
if [ "$1" = "__complete" ]; then
    exec python3 "$here/swarm/clitab.py" "$@"
fi
exec python3 "$here/swarm/cli.py" "$@"
